# results at 6 rad steering
delta_6 = np.deg2rad(6)
_, r_neutral_6 = steady_state_response(
    car_neutral,
    delta_6
)
_, r_understeer_6 = steady_state_response(
    car_understeer,
    delta_6
)

_, r_oversteer_6 = steady_state_response(
    car_oversteer,
    delta_6
)

# Calculate yaw-rate gains
gain_neutral = (
    r_neutral_6 / delta_6
)

gain_understeer = (
    r_understeer_6 / delta_6
)

gain_oversteer = (
    r_oversteer_6 / delta_6
)

# Percentage changes relative to neutral
