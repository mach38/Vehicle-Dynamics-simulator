# steady state response for end result
def steady_state_response(params, delta):
    # system matrix
    A = np.array([
        [
            -(params.Cf + params.Cr)
            / (params.m * params.Vx),

            -params.Vx
            - (params.Cf * params.lf - params.Cr * params.lr)
            / (params.m * params.Vx)
        ],
        [
            -(params.Cf * params.lf - params.Cr * params.lr)
            / (params.Iz * params.Vx),

            -(params.Cf * params.lf**2
              + params.Cr * params.lr**2)
            / (params.Iz * params.Vx)
        ]
    ])
    # Steering input vector
    B = np.array([
        params.Cf / params.m,
        params.Cf * params.lf / params.Iz
    ])
    steady_state = np.linalg.solve(
        A,
        -B * delta
    )
    return steady_state


# steady state handelling response
def handling_response(params, delta_range):
    alpha_difference = []
    yaw_rates = []
    for delta in delta_range:
        # solve for vy and r
        vy, r = steady_state_response(
            params,
            delta
        )
        # front tyre slip angle 
        alpha_f = (
            delta
            - (vy + params.lf * r)
            / params.Vx
        )
        # rear tyre slip angle
        alpha_r = (
            params.lr * r - vy
        ) / params.Vx
        # Difference in slip angles
        alpha_difference.append(
            alpha_f - alpha_r
        )
        # Store yaw rate
        yaw_rates.append(r)

    return (
        np.array(alpha_difference),
        np.array(yaw_rates)
    )


# steering angle sweep

