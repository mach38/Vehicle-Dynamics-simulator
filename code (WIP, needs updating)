class VehicleParas:
    def __init__(self, m, Iz, lf, lr, Cf, Cr, Vx):
        self.m = m
        self.Iz = Iz # m*L/3^3 with L = 2.6
        self.lf = lf
        self.lr = lr
        self.Cf = Cf
        self.Cr = Cr
        self.Vx = Vx # in m/s

