def state_derivative(t, x, params, delta_func):
    vy, r =x
    delta =delta_func(t)

    vy_dot=(-(params.Cf + params.Cr) / (params.m * params.Vx)) * vy \
             + (-params.Vx - (params.Cf * params.lf - params.Cr * params.lr) / (params.m * params.Vx)) * r \
             + (params.Cf / params.m) * delta

    r_dot =(-(params.Cf * params.lf - params.Cr * params.lr) / (params.Iz * params.Vx)) * vy \
    + -(params.Cf * params.lf **2 + params.Cr * params.lr**2)/ (params.Iz * params.Vx) * r \
    + (params.Cf * params.lf / params.Iz) * delta
    return [vy_dot, r_dot]

