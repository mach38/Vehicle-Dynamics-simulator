# installing all the relevant libraries
import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp

# vehicle parameters
class VehicleParams:
    def __init__(self, m, Iz, lf, lr, Cf, Cr, Vx):
        self.m = m
        self.Iz = Iz
        self.lf = lf
        self.lr = lr
        self.Cf = Cf
        self.Cr = Cr
        self.Vx = Vx

# Neutral vehicle for baseline
car_neutral = VehicleParams(
    m=1500,
    Iz=1128,
    lf=1.2,
    lr=1.4,
    Cf=80000,
    Cr=80000,
    Vx=20
)
# understeer configuration, higher rear stiffness relative to front
car_understeer = VehicleParams(
    m=1500,
    Iz=1128,
    lf=1.2,
    lr=1.4,
    Cf=63000,
    Cr=97000,
    Vx=20
)
# oversteer configuration, lower rear stiffness relative to front
car_oversteer = VehicleParams(
    m=1500,
    Iz=1128,
    lf=1.2,
    lr=1.4,
    Cf=97000,
    Cr=63000,
    Vx=20
)
# steering input for a 2 degree input applied at t = 0.5s
def delta_func(t):
    if t < 0.5:
        return 0.0
    else:
        return np.deg2rad(2)

# vehicle state derivative
def state_derivative(t, x, params, delta_func):
    # state variables
    vy, r = x
    # steering input
    delta = delta_func(t)
    # lateral velocity derivative
    vy_dot = (
        -(params.Cf + params.Cr)
        / (params.m * params.Vx)
    ) * vy + (
        -params.Vx
        - (params.Cf * params.lf - params.Cr * params.lr)
        / (params.m * params.Vx)
    ) * r + (
        params.Cf / params.m
    ) * delta

    # Yaw rate derivative
    r_dot = (
        -(params.Cf * params.lf - params.Cr * params.lr)
        / (params.Iz * params.Vx)
    ) * vy + (
        -(params.Cf * params.lf**2 + params.Cr * params.lr**2)
        / (params.Iz * params.Vx)
    ) * r + (
        params.Cf * params.lf / params.Iz
    ) * delta

    return [vy_dot, r_dot]
# transiet simulation, step steer is disturbance
def simulate_vehicle(params):

    t_span = (0, 4)
    t_eval = np.linspace(
        0,
        4,
        1000
    )
    initial_state = [0, 0]
    solution = solve_ivp( # for integration
        state_derivative,
        t_span,
        initial_state,
        args=(params, delta_func),
        t_eval=t_eval
    )

    return solution

# running step-steer simulation
sol_neutral = simulate_vehicle(car_neutral)
sol_understeer = simulate_vehicle(car_understeer)
sol_oversteer = simulate_vehicle(car_oversteer)

